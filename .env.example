# Till — environment template
# Copy to `.env` (gitignored). NEVER commit real keys.

# ── GitHub (NEVER commit the token) ──────────────────────────────────────────
GITHUB_REPO=https://github.com/Mr-Ben-dev/TILL
GITHUB_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Production boot MUST fail if TILL_DEV_SIMULATE=1
TILL_DEV_SIMULATE=0
LOG_LEVEL=info

# ── 0G Aristotle mainnet ─────────────────────────────────────────────────────
OG_CHAIN_ID=16661
OG_RPC_URL=https://evmrpc.0g.ai
OG_EXPLORER_URL=https://chainscan.0g.ai

# ── 0G Galileo testnet ───────────────────────────────────────────────────────
OG_TESTNET_CHAIN_ID=16602
OG_TESTNET_RPC_URL=https://evmrpc-testnet.0g.ai
OG_TESTNET_EXPLORER_URL=https://chainscan-galileo.0g.ai

# ── Wallets (NEVER commit) ───────────────────────────────────────────────────
# Hex key with or without 0x prefix. Dedicated Till deployer only.
# FORBIDDEN: a global OPERATOR_PRIVATE_KEY that can spend every user's Till.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Optional: reuse deployer for Storage uploads
OG_STORAGE_PRIVATE_KEY=

# ── 0G Compute Router ────────────────────────────────────────────────────────
OG_ROUTER_URL=https://router-api.0g.ai/v1
OG_ROUTER_TESTNET_URL=https://router-api-testnet.integratenetwork.work/v1
OG_ROUTER_API_KEY=
OG_ROUTER_MANAGEMENT_KEY=
# Do not hardcode a model. Runtime queries GET /v1/models.
# Optional preference only (must still be listed + TEE + JSON):
OG_PREFERRED_POLICY_MODEL=0gm-1.0-35b-a3b
OG_TRUST_MODE=private

# ── Payment Layer (Compute billing, not Till spend) ──────────────────────────
OG_PAYMENT_LAYER=0xA3b15Bd2aD18BFB6b5f92D8AA9F444Dd59d1cE32
OG_PAYMENT_LAYER_TESTNET=0x0AD9690e0b34aB2d493DE02cDF149ee34f6C9939

# ── Storage ──────────────────────────────────────────────────────────────────
OG_STORAGE_INDEXER_URL=https://indexer-storage-turbo.0g.ai
OG_STORAGE_INDEXER_TESTNET_URL=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_FLOW=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526
OG_W0G=0x1Cd0690fF9a693f5EF2dD976660a8dAFc81A109c

# ── ERC-8004 (0G mainnet registries) ─────────────────────────────────────────
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ── Contracts (filled after deploy) ──────────────────────────────────────────
TILL_AGENT_NFT=0x730e7c02D1C238D98aD38AFED98a7CBA980901bF
TILL_VAULT=0x2eD09745E5Ca4BdeaBc93aB3aab65781B03Ed4cB
TILL_POLICY=0xBf05e322e3C3047089e9Dd9E10Bd8ee320149f7c
TILL_VERIFIER=0x4C8bed5Ec7e1F0c0CC7a7Ef141370dd9f4e1A7f1
TILL_JOB_ESCROW=0x1BB730Ff8A4Ff93dE9eDD54B178C0Bc9ddE99de9

# ── Backend (Phase 10) ───────────────────────────────────────────────────────
PORT=3001
PUBLIC_API_URL=
# Optional. Do not use as money authority.
DATABASE_URL=

# ── Frontend public (VITE_ is exposed to the browser) ────────────────────────
VITE_CHAIN_ID=16661
VITE_RPC_URL=https://evmrpc.0g.ai
VITE_EXPLORER_URL=https://chainscan.0g.ai
VITE_API_URL=
VITE_WALLETCONNECT_PROJECT_ID=
# Optional social login
VITE_PRIVY_APP_ID=

# Do not add OpenAI, Groq, or any inference fallback keys.
# Do not set TILL_DEV_SIMULATE=1 when NODE_ENV=production.
